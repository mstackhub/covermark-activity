# ========================================================
# Covermark Activity - Vercel Environment Variables
# ========================================================
# Copy these keys into your Vercel Project Settings -> Environment Variables

# 1. Turso Database Connection URL
TURSO_DATABASE_URL="libsql://covermark-activity-mstackhub.aws-ap-northeast-1.turso.io"

# 2. Turso Auth Token (Generate from Turso dashboard or `turso db tokens create covermark-activity`)
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# 3. Admin Security Token
API_KEY="COVERMARK_SECRET_API_KEY"
